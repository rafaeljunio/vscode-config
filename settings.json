{
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[prisma]": {
    "editor.defaultFormatter": "Prisma.prisma"
  },

  "console-ninja.featureSet": "Community",

  "cSpell.blockCheckingWhenTextChunkSizeGreaterThan": 2000,
  "cSpell.enableFiletypes": [
    "!asciidoc",
    "!c",
    "!cpp",
    "!csharp",
    "!go",
    "!handlebars",
    "!haskell",
    "!jade",
    "!java",
    "!latex",
    "!php",
    "!pug",
    "!python",
    "!restructuredtext",
    "!rust",
    "!scala",
    "!scss"
  ],
  "cSpell.language": "en,pt",
  "cSpell.userWords": [
    "bootcamp",
    "broklinn",
    "chakra",
    "checkin",
    "checkins",
    "clsx",
    "cmdk",
    "cnpj",
    "Cnpj",
    "Codegen",
    "datadog",
    "datasource",
    "Datetime",
    "dayjs",
    "Ddrgd",
    "descricao",
    "Dotenv",
    "Elysia",
    "embla",
    "esbuild",
    "fastify",
    "Fastify",
    "feedbackwidget",
    "ffprobe",
    "gamehub",
    "geist",
    "Hasher",
    "Hono",
    "hookform",
    "Idcr",
    "ilike",
    "influencers",
    "Influencers",
    "IUGU",
    "jamjuree",
    "jupiter",
    "kinde",
    "liveblocks",
    "LIVEBLOCKS",
    "livekit",
    "LIVEKIT",
    "logomark",
    "Marguerita",
    "middlewares",
    "mixpanel",
    "monaco",
    "mysql",
    "nestjs",
    "nextjs",
    "novu",
    "omni",
    "Omni",
    "Onboarded",
    "pagarme",
    "pallas",
    "paymentlinks",
    "postgres",
    "postgresql",
    "prefetch",
    "qhjm",
    "Qrcode",
    "reactflow",
    "roboto",
    "rocketseat",
    "rotion",
    "rsxp",
    "Sandpack",
    "sellit",
    "Sellit",
    "sellitbr",
    "shiki",
    "skylab",
    "sonner",
    "sqlite",
    "supergraph",
    "svgr",
    "sympla",
    "tailwindcss",
    "tanstack",
    "textblock",
    "tiptap",
    "trpc",
    "TRPC",
    "trunkio",
    "tsup",
    "turbopack",
    "ulidx",
    "unfollow",
    "Unfollow",
    "unform",
    "Unform",
    "unmark",
    "UPLOADTHING",
    "upsert",
    "Usuario",
    "vaul",
    "Vcobevx",
    "Viewqrcode",
    "WEBPUSH",
    "whsec"
  ],

  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.accessibilitySupport": "off",
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "block",
  // "editor.defaultFormatter": "biomejs.biome",
  "editor.fontFamily": "Cascadia Code, Consolas",
  // "editor.fontFamily": "DejaVu Sans Mono",
  // "editor.fontFamily": "Fira Code",
  // "editor.fontFamily": "JetBrains Mono",
  // "editor.fontFamily": "Monaco",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'zero', 'onum'",
  // "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.fontWeight": "300",
  // "editor.fontWeight": "800",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  // "editor.hideCursorInOverviewRuler": true,
  "editor.inlineSuggest.suppressSuggestions": true,
  // "editor.letterSpacing": 0.2,
  "editor.lineHeight": 2.0,
  "editor.minimap.enabled": true,
  "editor.parameterHints.enabled": true,
  "editor.renderLineHighlight": "gutter",
  // "editor.renderWhitespace": "boundary",
  // "editor.rulers": [
  //   80,
  //   120
  // ],
  "editor.semanticHighlighting.enabled": false,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": false,
  // "editor.suggest.showClasses": false,
  // "editor.suggest.showColors": false,
  // "editor.suggest.showConstants": false,
  // "editor.suggest.showConstructors": true,
  // "editor.suggest.showFunctions": true,
  // "editor.suggest.showKeywords": false,
  // "editor.suggest.showModules": true,
  // "editor.suggest.showSnippets": false,
  // "editor.suggest.showValues": true,
  "editor.suggestSelection": "first",
  "editor.tabSize": 2,

  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "emmet.syntaxProfiles": {
    "javascript": "jsx"
  },

  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "graphql"
  ],

  "explorer.compactFolders": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": false,
  "explorer.fileNesting.patterns": {
    ".env": ".env*",
    ".env.local": ".env*",
    "package.json": ".eslint*, prettier*, tsconfig*, vite*, pnpm-lock*, bun.lockb, nest*",
    "tailwind.config.js": "tailwind.config*, postcss.config*"
  },
  "explorer.sortOrder": "foldersNestsFiles",

  "extensions.ignoreRecommendations": true,

  "files.associations": {
    "*.css": "css",
    "*.ts": "typescript",
    ".env.*": "dotenv",
    ".prettierrc": "json"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true,
    "**/CVS": true
  },
  "files.watcherExclude": {
    "**/.trunk/*actions/": true,
    "**/.trunk/*logs/": true,
    "**/.trunk/*notifications/": true,
    "**/.trunk/*out/": true,
    "**/.trunk/*plugins/": true
  },

  "git.autofetch": true,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "always",

  "gitlens.codeLens.authors.enabled": false,
  "gitlens.codeLens.recentChange.enabled": false,

  "javascript.suggest.autoImports": true,
  "javascript.updateImportsOnFileMove.enabled": "always",

  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "newWindow",

  "symbols.hidesExplorerArrows": false,

  "tabnine.experimentalAutoImports": true,

  "tailwindCSS.experimental.classRegex": [
    [
      "tv\\(([^)]*)\\)",
      "[\"'`]([^\"'`]*).*?[\"'`]"
    ]
  ],

  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },
  // "terminal.integrated.fontFamily": "Fira Code Nerd Font Mono",
  "terminal.integrated.fontFamily": "MesloLGS NF",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.fontWeight": "300",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.showExitAlert": false,

  "trunk.showPreexistingIssues": true,

  "turboConsoleLog.includeFileNameAndLineNum": true,
  "turboConsoleLog.quote": "'",

  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "typescript.suggest.autoImports": true,
  "typescript.tsserver.log": "off",
  "typescript.updateImportsOnFileMove.enabled": "always",

  "update.mode": "start",
  "update.showReleaseNotes": false,

  "window.commandCenter": true,
  "window.confirmSaveUntitledWorkspace": false,
  "window.zoomLevel": 0.7,

  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#F4D93A"
  },
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.editor.customLabels.patterns": {
    "**/{layout,page}.tsx": "${dirname} ${filename}"
  },
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.labelFormat": "short",
  "workbench.editor.wrapTabs": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.tree.enableStickyScroll": false
}
